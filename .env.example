# ─────────────────────────────────────────────
# .env.example — Copy this to .env and fill in
# NEVER commit the actual .env to GitHub!
# ─────────────────────────────────────────────

# ── Telegram ──────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your bot's username (without @)
BOT_USERNAME=YourStickerBot

# Price in Telegram Stars (150 Stars ≈ $2 USD)
PACK_PRICE_STARS=150

# Your Telegram user ID (for admin commands)
ADMIN_IDS=123456789

# ── fal.ai ────────────────────────────────────
# Get from https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_key_here

# ── OpenAI (content moderation - free) ────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ── Redis (optional - for production queue) ───
# Railway auto-provides this if you add Redis plugin
# Leave as default for local dev (uses in-memory queue)
REDIS_URL=redis://localhost:6379

# ── Rate Limiting ──────────────────────────────
# Free requests per user per day
FREE_DAILY_LIMIT=3

# Seconds between requests per user
RATE_LIMIT_SECONDS=120
